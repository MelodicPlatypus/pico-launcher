+#pragma once
+#include <unordered_map>
+#include <string>
+#include "arm9/source/romBrowser/DisplayMode/RomBrowserDisplayMode.h"
+
+// NOTE: This header may already exist in your tree in a slightly different location/name.
+// If so, merge these fields into the existing struct/class instead of creating a duplicate.
+struct RomBrowserDisplaySettings {
+    RomBrowserLayout layout = RomBrowserLayout::HorizontalGrid; // global default
+    RomBrowserSortMode sortMode = RomBrowserSortMode::NameAscending;
+    bool perFolderLayoutEnabled = false; // NEW: toggle
+    // NEW: exact-path overrides
+    std::unordered_map<std::string, RomBrowserLayout> folderLayoutOverrides;
+    std::unordered_map<std::string, std::string>      folderIconOverrides; // name from theme folder_icons
+};
+
+// Helpers (string <-> enum). If your codebase already has these, reuse them.
+static inline const char* LayoutToString(RomBrowserLayout l) {
+    switch (l) {
+        case RomBrowserLayout::HorizontalGrid: return "HorizontalGrid";
+        case RomBrowserLayout::VerticalGrid:   return "VerticalGrid";
+        case RomBrowserLayout::BannerList:     return "BannerList";
+        case RomBrowserLayout::CoverFlow:      return "Coverflow";
+        default:                               return "HorizontalGrid";
+    }
+}
+static inline RomBrowserLayout ParseLayoutFromString(const char* s) {
+    if (!s) return RomBrowserLayout::HorizontalGrid;
+    if (!strcasecmp(s, "HorizontalGrid")) return RomBrowserLayout::HorizontalGrid;
+    if (!strcasecmp(s, "VerticalGrid"))   return RomBrowserLayout::VerticalGrid;
+    if (!strcasecmp(s, "BannerList"))     return RomBrowserLayout::BannerList;
+    if (!strcasecmp(s, "Coverflow") || !strcasecmp(s, "CoverFlow")) return RomBrowserLayout::CoverFlow;
+    return RomBrowserLayout::HorizontalGrid;
+}
diff --git a/arm9/source/services/settings/RomBrowserDisplaySettings.cpp b/arm9/source/services/settings/RomBrowserDisplaySettings.cpp
new file mode 100644
--- /dev/null
+++ b/arm9/source/services/settings/RomBrowserDisplaySettings.cpp
@@ -0,0 +1,123 @@
+#include "RomBrowserDisplaySettings.h"
+#include "arm9/source/json/ArduinoJson.h"
+#include "arm9/source/fat/File.h"
+
+// Minimal loader/saver for /_pico/settings.json
+// If your project already has a settings service, merge these bits in that service instead.
+
+static const char* kSettingsPath = "/_pico/settings.json";
+
+static bool LoadAll(JsonDocument& doc) {
+    File f;
+    if (f.Open(kSettingsPath, FA_READ | FA_OPEN_EXISTING) != FR_OK) return false;
+    u32 size = f.GetSize();
+    if (!size) { f.Close(); return false; }
+    std::unique_ptr<u8[]> buf(new u8[size]);
+    u32 read = 0; f.Read(buf.get(), size, read); f.Close();
+    if (read != size) return false;
+    auto err = deserializeJson(doc, buf.get(), size);
+    return !err;
+}
+
+bool LoadRomBrowserDisplaySettings(RomBrowserDisplaySettings& out) {
+    StaticJsonDocument<4096> doc;
+    if (!LoadAll(doc)) return false;
+    // global layout
+    out.layout = ParseLayoutFromString(doc["romBrowserLayout"].as<const char*>());
+    // sort
+    const char* sm = doc["romBrowserSortMode"] | "NameAscending";
+    out.sortMode = (!strcasecmp(sm, "NameDescending")) ? RomBrowserSortMode::NameDescending
+                                                       : RomBrowserSortMode::NameAscending;
+    // per-folder toggle
+    out.perFolderLayoutEnabled = doc["perFolderLayoutEnabled"] | false;
+    // folderLayoutOverrides
+    if (auto o = doc["folderLayoutOverrides"].as<JsonObjectConst>()) {
+        for (auto kv : o) {
+            out.folderLayoutOverrides[kv.key().c_str()] = ParseLayoutFromString(kv.value().as<const char*>());
+        }
+    }
+    // folderIconOverrides
+    if (auto o2 = doc["folderIconOverrides"].as<JsonObjectConst>()) {
+        for (auto kv : o2) {
+            out.folderIconOverrides[kv.key().c_str()] = kv.value().as<const char*>();
+        }
+    }
+    return true;
+}
+
+bool SaveRomBrowserDisplaySettings(const RomBrowserDisplaySettings& in) {
+    StaticJsonDocument<4096> doc;
+    // Load existing to preserve unknown keys
+    LoadAll(doc);
+    doc["romBrowserLayout"] = LayoutToString(in.layout);
+    doc["romBrowserSortMode"] = (in.sortMode == RomBrowserSortMode::NameDescending) ? "NameDescending" : "NameAscending";
+    doc["perFolderLayoutEnabled"] = in.perFolderLayoutEnabled;
+    // overrides
+    auto o = doc.createNestedObject("folderLayoutOverrides");
+    for (auto& kv : in.folderLayoutOverrides) o[kv.first.c_str()] = LayoutToString(kv.second);
+    auto o2 = doc.createNestedObject("folderIconOverrides");
+    for (auto& kv : in.folderIconOverrides)  o2[kv.first.c_str()] = kv.second.c_str();
+    // Write back
+    File f;
+    if (f.Open(kSettingsPath, FA_WRITE | FA_CREATE_ALWAYS) != FR_OK) return false;
+    char outBuf[4096];
+    size_t n = serializeJson(doc, outBuf, sizeof(outBuf));
+    u32 written = 0; f.Write(outBuf, n, written); f.Close();
+    return written == n;
+}
