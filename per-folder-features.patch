+#pragma once
+#include <unordered_map>
+#include <string>
+#include <memory>
+#include "themes/ITheme.h"
+#include "gui/IVramManager.h"
+
+// Loads optional /folder_icons/<name>.bin + <name>Pltt.bin from the active theme.
+// Mirrors the existing runtime theme asset pattern used by the Custom theme (gridcell*, scrim*).  
+class ThemeFolderIconRepository {
+public:
+    struct IconVram { u32 tex = 0; u32 pltt = 0; };
+    ThemeFolderIconRepository(const ITheme* theme, const VramContext* vctx)
+        : _theme(theme), _vctx(vctx) {}
+    void Reload(const ITheme* theme, const VramContext* vctx) { _theme = theme; _vctx = vctx; _cache.clear(); }
+    bool Has(const std::string& name) const;
+    IconVram EnsureLoaded(const std::string& name);
+    void Clear() { _cache.clear(); }
+private:
+    const ITheme* _theme = nullptr;
+    const VramContext* _vctx = nullptr;
+    std::unordered_map<std::string, IconVram> _cache;
+};
diff --git a/arm9/source/themes/ThemeFolderIconRepository.cpp b/arm9/source/themes/ThemeFolderIconRepository.cpp
new file mode 100644
--- /dev/null
+++ b/arm9/source/themes/ThemeFolderIconRepository.cpp
@@ -0,0 +1,84 @@
+#include "ThemeFolderIconRepository.h"
+#include "fat/File.h"
+#include <memory>
+#include <string.h>
+
+bool ThemeFolderIconRepository::Has(const std::string& name) const {
+    if (!_theme) return false;
+    File f;
+    char p[96];
+    mini_snprintf(p, sizeof(p), "folder_icons/%s.bin", name.c_str());
+    if (_theme->OpenThemeFile(f, p)) { f.Close(); return true; }
+    return false;
+}
+
+ThemeFolderIconRepository::IconVram ThemeFolderIconRepository::EnsureLoaded(const std::string& name) {
+    auto it = _cache.find(name);
+    if (it != _cache.end()) return it->second;
+    IconVram out{};
+    if (!_theme || !_vctx) return out;
+    File f;
+    char p[96];
+    // texture (64x64 4-bpp raw tiles = 2048 bytes)
+    mini_snprintf(p, sizeof(p), "folder_icons/%s.bin", name.c_str());
+    if (_theme->OpenThemeFile(f, p)) {
+        std::unique_ptr<u8[]> buf(new (cache_align) u8[2048]);
+        u32 br = 0; f.Read(buf.get(), 2048, br); f.Close();
+        if (br == 2048) {
+            u32 off = _vctx->GetTexVramManager()->Alloc(2048);
+            mem_setVramDMapping(MEM_VRAM_D_LCDC);
+            memcpy((void*)_vctx->GetTexVramManager()->GetVramAddress(off), buf.get(), 2048);
+            mem_setVramDMapping(MEM_VRAM_D_TEX_SLOT_0);
+            out.tex = off;
+        }
+    }
+    // palette (16 colors * 2 bytes = 32 bytes; BGR555)
+    mini_snprintf(p, sizeof(p), "folder_icons/%sPltt.bin", name.c_str());
+    if (_theme->OpenThemeFile(f, p)) {
+        std::unique_ptr<u8[]> buf(new (cache_align) u8[32]);
+        u32 br = 0; f.Read(buf.get(), 32, br); f.Close();
+        if (br == 32) {
+            u32 off = _vctx->GetTexPlttVramManager()->Alloc(32);
+            mem_setVramEMapping(MEM_VRAM_E_LCDC);
+            memcpy((void*)_vctx->GetTexPlttVramManager()->GetVramAddress(off), buf.get(), 32);
+            mem_setVramEMapping(MEM_VRAM_E_TEX_PLTT_SLOT_0123);
+            out.pltt = off;
+        }
+    }
+    if (out.tex && out.pltt) _cache[name] = out;
+    return out;
+}
