--- /dev/null
+++ b/tools/generate_pink_folder_icon.py
@@ -0,0 +1,118 @@
+#!/usr/bin/env python3
+"""
+Generate a simple 64x64 4-bpp tiled texture (2048 bytes) filled with palette index 1
+and a 16-color BGR555 palette (32 bytes) where index 1 is "pink".
+This matches what the runtime loader expects for folder_icons/<name>.bin and <name>Pltt.bin.
+"""
+import os, struct
+
+ROOT = os.path.dirname(os.path.dirname(__file__))
+OUT_DIR = os.path.join(ROOT, "_pico", "themes", "demo", "folder_icons")
+
+def ensure_dir(p):
+    os.makedirs(p, exist_ok=True)
+
+def bgr555(r,g,b):
+    # Convert 8-bit RGB to 5-bit BGR (Nintendo DS format): bits: 0-4 blue, 5-9 green, 10-14 red, bit15 unused
+    rb = (b & 0xF8) >> 3
+    gb = (g & 0xF8) >> 3
+    rb_r = (r & 0xF8) >> 3
+    val = (rb) | (gb << 5) | (rb_r << 10)
+    return struct.pack("<H", val)
+
+def write_pink(name="pink"):
+    ensure_dir(OUT_DIR)
+    tex_path = os.path.join(OUT_DIR, f"{name}.bin")
+    pal_path = os.path.join(OUT_DIR, f"{name}Pltt.bin")
+    # 64x64 @ 4bpp = 4096 pixels * 0.5 bytes = 2048 bytes
+    # Fill with palette index 1 (each byte carries two pixels: high nibble and low nibble).
+    tex = bytes([0x11]) * 2048
+    with open(tex_path, "wb") as f:
+        f.write(tex)
+    # 16 * 2 bytes palette
+    # index 0 = transparent-ish black (0,0,0), index 1 = pink (#EC4899), others = 0
+    pal = bytearray(32)
+    pal[0:2] = bgr555(0,0,0)
+    pal[2:4] = bgr555(236,72,153)
+    with open(pal_path, "wb") as f:
+        f.write(pal)
+    print("Wrote:", tex_path, pal_path)
+
+if __name__ == "__main__":
+    write_pink("pink")
+    # You can duplicate with other names if desired, e.g.:
+    # write_pink("chip")
